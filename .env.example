# ---- Core --------------------------------------------------------------------
# SQLite for local development. For production use PostgreSQL: change the
# datasource provider in prisma/schema.prisma to "postgresql" and set this URL.
DATABASE_URL="file:./dev.db"
# "true" seeds labeled sample data, blocks outbound email/SMS/push and live
# payment keys, and shows the demo banner. MUST be "false" before real bookings.
DEMO_MODE="true"
APP_URL="http://localhost:3000"
APP_TIME_ZONE="America/New_York"

# ---- Scheduled job (offer timeouts, dispatch rounds, notification retries) -----
# Call GET/POST /api/cron/sweep every minute with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# ---- Maps: address lookup, route distance, ETA, interactive pin map ------------
# Mapbox (preferred: also powers the in-app map)
MAPBOX_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""
# or Google Maps (Geocoding + Distance Matrix APIs)
GOOGLE_MAPS_API_KEY=""
# Optional override: mapbox | google | none
MAPS_PROVIDER=""

# ---- Payments (Stripe) -- use TEST keys (sk_test_/pk_test_) until launch review --
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- SMS + phone verification (Twilio) ------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---- Push notifications (your push gateway / relay) -----------------------------
PUSH_WEBHOOK_URL=""

# ---- Private uploads (license, insurance, photos) -------------------------------
UPLOAD_DIR="./storage/uploads"

# "true" serves only /launch and /demo/* (the public concept site, no database needed). Leave unset for the full app.
DEMO_SITE=""
